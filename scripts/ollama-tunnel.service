[Unit]
Description=Autossh tunnel to vast.ai — Ollama (11435) and Whisper STT (18081)
After=network.target

[Service]
Type=simple
User=www-data
Environment="AUTOSSH_GATETIME=0"
Environment="AUTOSSH_POLL=30"
Environment="AUTOSSH_LOGFILE=/var/www/clients/client1/web64/web/logs/ollama-tunnel.log"
Environment="AUTOSSH_DEBUG=1"
ExecStart=/usr/bin/autossh -M 0 -N \
    -L 11435:127.0.0.1:11434 \
    -L 18081:127.0.0.1:18081 \
    root@123.21.129.10 -p 51734 \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    -o ExitOnForwardFailure=yes \
    -o StrictHostKeyChecking=no
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
